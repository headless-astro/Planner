// The planner's sync and reminder server (PLAN.md 12.6).
// Before the first deploy, put the id that `npx wrangler d1 create planner` prints into database_id.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "planner-sync",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	// Lets the AI connector's sign-in check an app's published details (F74).
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "planner",
			"database_id": "c4fe60c6-1346-4f1d-89af-6ce00214d21e",
			"migrations_dir": "migrations"
		}
	],
	// Sign-ins for the AI connector (F74). Wrangler creates it on the first deploy.
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "4f43029cd8bf495696a9a0b53ae77ffa"
		}
	],
	"vars": {
		"APP_URL": "https://headless-astro.github.io/Planner/"
	},
	// Every 5 minutes: is a reminder due? (PLAN.md 11.5)
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}